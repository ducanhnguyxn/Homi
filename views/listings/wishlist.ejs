<% layout("/layouts/boilerplate.ejs") %>
<h3 class="mt-3 mb-4"><i class="fa-solid fa-heart" style="color: var(--homi-primary);"></i> My Wishlist</h3>

<% if (wishlistListings.length === 0) { %>
    <p class="text-muted">You haven't saved any listings yet. Tap the heart on a listing to add it here.</p>
<% } else { %>
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3 mt-2">
    <% for(let listing of wishlistListings) { %>
        <div class="col">
            <div class="position-relative">
                <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="wishlist-btn-form">
                    <button type="submit" class="wishlist-heart" aria-label="Remove from wishlist">
                        <i class="fa-solid fa-heart"></i>
                    </button>
                </form>
                <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none">
                    <div class="card h-100">
                        <img
                            src="<%= listing.image.url %>"
                            class="card-img-top"
                            alt="listing_image"
                            style="height: 15rem; object-fit: cover;"
                        />
                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.title %></b> <br>
                                <span class="text-muted">£<%= listing.price %> / night</span>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    <% } %>
</div>
<% } %>
